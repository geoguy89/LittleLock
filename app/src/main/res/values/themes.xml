<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.LittleLock" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/littlelock_primary</item>
        <item name="colorPrimaryVariant">@color/littlelock_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/littlelock_accent</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:colorBackground">@color/littlelock_background</item>
        <item name="android:statusBarColor">@color/littlelock_primary_dark</item>
        <item name="android:navigationBarColor">@color/littlelock_primary</item>
    </style>

    <!-- Settings theme -->
    <style name="Theme.LittleLock.Settings" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/littlelock_primary</item>
        <item name="colorPrimaryVariant">@color/littlelock_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/littlelock_accent</item>
        <item name="android:colorBackground">@color/littlelock_background</item>
        <item name="android:statusBarColor">@color/littlelock_primary_dark</item>
    </style>

    <!-- PIN Lock theme -->
    <style name="Theme.LittleLock.PinLock" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/littlelock_pin_button</item>
        <item name="colorOnPrimary">@color/littlelock_pin_button_text</item>
        <item name="android:colorBackground">@color/littlelock_pin_bg</item>
        <item name="android:statusBarColor">@color/littlelock_pin_bg</item>
        <item name="android:navigationBarColor">@color/littlelock_pin_bg</item>
    </style>

    <!-- Parent-chosen accent colours: applied on top of the themes above (see Accent.kt) -->
    <style name="Accent.Purple" parent="">
        <item name="colorPrimary">#FF6C63FF</item>
        <item name="colorPrimaryVariant">#FF544DB7</item>
        <item name="android:statusBarColor">#FF544DB7</item>
    </style>

    <style name="Accent.Blue" parent="">
        <item name="colorPrimary">#FF2F80ED</item>
        <item name="colorPrimaryVariant">#FF1F5FB8</item>
        <item name="android:statusBarColor">#FF1F5FB8</item>
    </style>

    <style name="Accent.Teal" parent="">
        <item name="colorPrimary">#FF00A896</item>
        <item name="colorPrimaryVariant">#FF007A6C</item>
        <item name="android:statusBarColor">#FF007A6C</item>
    </style>

    <style name="Accent.Green" parent="">
        <item name="colorPrimary">#FF3BAA4A</item>
        <item name="colorPrimaryVariant">#FF28782F</item>
        <item name="android:statusBarColor">#FF28782F</item>
    </style>

    <style name="Accent.Orange" parent="">
        <item name="colorPrimary">#FFF2842B</item>
        <item name="colorPrimaryVariant">#FFB8611A</item>
        <item name="android:statusBarColor">#FFB8611A</item>
    </style>

    <style name="Accent.Red" parent="">
        <item name="colorPrimary">#FFE5484D</item>
        <item name="colorPrimaryVariant">#FFAE3236</item>
        <item name="android:statusBarColor">#FFAE3236</item>
    </style>

    <style name="Accent.Pink" parent="">
        <item name="colorPrimary">#FFE4559B</item>
        <item name="colorPrimaryVariant">#FFAE3A76</item>
        <item name="android:statusBarColor">#FFAE3A76</item>
    </style>

    <style name="Accent.Gray" parent="">
        <item name="colorPrimary">#FF5F6B7A</item>
        <item name="colorPrimaryVariant">#FF434C57</item>
        <item name="android:statusBarColor">#FF434C57</item>
    </style>
</resources>
