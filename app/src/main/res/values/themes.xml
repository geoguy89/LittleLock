<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.LittleLock" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/littlelock_primary</item>
        <item name="colorPrimaryVariant">@color/littlelock_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/littlelock_accent</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:colorBackground">@color/littlelock_background</item>
        <item name="android:statusBarColor">@color/littlelock_primary_dark</item>
        <item name="android:navigationBarColor">@color/littlelock_primary</item>
    </style>

    <!-- Settings theme -->
    <style name="Theme.LittleLock.Settings" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/littlelock_primary</item>
        <item name="colorPrimaryVariant">@color/littlelock_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/littlelock_accent</item>
        <item name="android:colorBackground">@color/littlelock_background</item>
        <item name="android:statusBarColor">@color/littlelock_primary_dark</item>
    </style>

    <!-- PIN Lock theme -->
    <style name="Theme.LittleLock.PinLock" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/littlelock_pin_button</item>
        <item name="colorOnPrimary">@color/littlelock_pin_button_text</item>
        <item name="android:colorBackground">@color/littlelock_pin_bg</item>
        <item name="android:statusBarColor">@color/littlelock_pin_bg</item>
        <item name="android:navigationBarColor">@color/littlelock_pin_bg</item>
    </style>
</resources>
