<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/littlelock_pin_bg"
    android:gravity="center">

    <TextView
        android:id="@+id/tvPinTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pin_enter_title"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <!-- PIN dots display -->
    <LinearLayout
        android:id="@+id/llPinDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="32dp">

        <ImageView
            android:id="@+id/ivDot1"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_margin="8dp"
            android:background="@drawable/ic_app_icon_1"
            android:alpha="0.3" />

        <ImageView
            android:id="@+id/ivDot2"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_margin="8dp"
            android:background="@drawable/ic_app_icon_2"
            android:alpha="0.3" />

        <ImageView
            android:id="@+id/ivDot3"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_margin="8dp"
            android:background="@drawable/ic_app_icon_3"
            android:alpha="0.3" />

        <ImageView
            android:id="@+id/ivDot4"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_margin="8dp"
            android:background="@drawable/ic_app_icon_4"
            android:alpha="0.3" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPinError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FF6B6B"
        android:textSize="14sp"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <!-- Number pad -->
    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4">

        <!-- Row 1 -->
        <Button
            android:id="@+id/btn1"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="1"
            android:textSize="24sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/littlelock_pin_button" />

        <Button
            android:id="@+id/btn2"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="2"
            android:textSize="24sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/littlelock_pin_button" />

        <Button
            android:id="@+id/btn3"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="3"
            android:textSize="24sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/littlelock_pin_button" />

        <!-- Row 2 -->
        <Button
            android:id="@+id/btn4"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="4"
            android:textSize="24sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/littlelock_pin_button" />

        <Button
            android:id="@+id/btn5"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="5"
            android:textSize="24sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/littlelock_pin_button" />

        <Button
            android:id="@+id/btn6"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="6"
            android:textSize="24sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/littlelock_pin_button" />

        <!-- Row 3 -->
        <Button
            android:id="@+id/btn7"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="7"
            android:textSize="24sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/littlelock_pin_button" />

        <Button
            android:id="@+id/btn8"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="8"
            android:textSize="24sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/littlelock_pin_button" />

        <Button
            android:id="@+id/btn9"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="9"
            android:textSize="24sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/littlelock_pin_button" />

        <!-- Row 4 -->
        <View
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp" />

        <Button
            android:id="@+id/btn0"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="0"
            android:textSize="24sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/littlelock_pin_button" />

        <Button
            android:id="@+id/btnClear"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="⌫"
            android:textSize="20sp"
            android:textColor="#FF6B6B"
            android:backgroundTint="@android:color/transparent" />
    </GridLayout>

</LinearLayout>
