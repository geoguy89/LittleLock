<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/littlelock_background">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#CC6C63FF"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/launcher_title"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/launcher_parent_button"
            android:src="@drawable/ic_lock"
            android:tint="@color/white" />
    </LinearLayout>

    <!-- Shown when the parent has turned kid mode off -->
    <TextView
        android:id="@+id/tvKidModeOff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/littlelock_accent"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/launcher_kid_mode_off"
        android:textColor="@color/white"
        android:visibility="gone" />

    <!-- App grid (allowed apps only) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/scrollApps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="none">

            <com.littlelock.app.AppGrid
                android:id="@+id/gridApps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp" />
        </ScrollView>

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/launcher_empty"
            android:textColor="@color/littlelock_text_secondary"
            android:textSize="18sp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
