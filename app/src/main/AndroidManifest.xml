<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Foreground service for launcher overlay -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Package visibility -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Usage stats -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- System overlay / drawing over other apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.SYSTEM_OVERLAY_WINDOW" />

    <!-- Boot completed -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Wallpaper -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- Biometric -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Network -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Kill background processes -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- Wake lock -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".LittleLockApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LittleLock"
        tools:targetApi="36">

        <!-- Setup Activity - entry point -->
        <activity
            android:name=".ui.setup.SetupActivity"
            android:exported="true"
            android:theme="@style/Theme.LittleLock.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Parent Dashboard -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.LittleLock" />

        <!-- Child-facing Launcher -->
        <activity
            android:name=".ui.launcher.KidsLauncherActivity"
            android:exported="false"
            android:theme="@style/Theme.LittleLock.Kids"
            android:screenOrientation="portrait" />

        <!-- Settings -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.LittleLock" />

        <!-- Launcher Service (foreground) -->
        <service
            android:name=".service.LauncherService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- Usage Tracking Service -->
        <service
            android:name=".service.UsageTrackingService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- Discord Webhook Service -->
        <service
            android:name=".service.DiscordWebhookService"
            android:exported="false" />

        <!-- Boot receiver to restart services -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
